{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "APP_ROUTER_URL",
    "PAGES_ROUTER_URL",
    "APP_PAGES_ROUTER_URL",
    "EXPERIMENTAL_APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "e2e:test": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "openbuild:local": {
      "dependsOn": ["@opennextjs/aws#build", "^openbuild:local"],
      "outputs": [".open-next/**"]
    },
    "openbuild:local:start": {
      "cache": false,
      "dependsOn": ["openbuild:local"]
    }
  }
}
